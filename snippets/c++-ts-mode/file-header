 */

`(let ((ext (file-name-extension (or (buffer-file-name) "")))
       (macro (upcase (concat "_RCL_" (replace-regexp-in-string "-" "_" (file-name-base (or (buffer-file-name) (buffer-name)))) "_H"))))
   (if (member ext '("h" "hpp" "hxx" "H"))
       (concat "#ifndef " macro "\n#define " macro "\n")
     ""))`
$0

